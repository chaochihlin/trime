# Release build 簽章設定範本
# 使用方式：
#   1. 複製此檔為 keystore.properties（已在 .gitignore，不會被追蹤）
#   2. 填入實際的 keystore 路徑與密碼
#   3. 執行 make release 或 ./gradlew assembleRelease 產生 release APK
#
# 若僅執行 debug build（make debug），不需要此檔。

# keystore (.jks) 檔案絕對路徑或相對於專案根目錄的路徑
storeFile=/absolute/path/to/your-release.jks

# keystore 密碼
storePassword=YOUR_STORE_PASSWORD

# key alias 名稱
keyAlias=YOUR_KEY_ALIAS

# key 密碼
keyPassword=YOUR_KEY_PASSWORD
